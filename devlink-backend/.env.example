PORT=3000
NODE_ENV=development

# Allowed Frontend URLs (comma-separated if multiple origins)
FRONTEND_URL=http://localhost:5173,https://dev-link-frontend-mu.vercel.app

# MongoDB Connection URI (e.g. from MongoDB Atlas Free Shared Cluster M0)
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/devlink?retryWrites=true&w=majority

# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/devlink

# JSON Web Token Secret
JWT_SECRET=replace_with_a_long_random_secret_key_devlink
JWT_EXPIRES_IN=7d

# Cloudinary (Image upload storage)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_KEY=your_cloudinary_api_key
CLOUD_SECRET=your_cloudinary_api_secret
